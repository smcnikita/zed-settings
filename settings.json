{
	"features": {
		"edit_prediction_provider": "none"
	},
	"restore_on_startup": "none",
	"agent_servers": {
		"claude": null,
		"gemini": null
	},
	"inlay_hints": {
		"enabled": true,
		"show_value_hints": true,
		"show_type_hints": false,
		"show_parameter_hints": true,
		"show_other_hints": true,
		"show_background": false,
		"edit_debounce_ms": 700,
		"scroll_debounce_ms": 50,
		"toggle_on_modifiers_press": {
			"control": false,
			"alt": false,
			"shift": false,
			"platform": false,
			"function": false
		}
	},
	"minimap": {
		"show": "never"
	},
	"hover_popover_delay": 1000,
	"git": {
		"inline_blame": {
			"enabled": true,
			"delay_ms": 0,
			"padding": 7,
			"min_column": 0,
			"show_commit_summary": false
		}
	},
	"terminal": {
		"blinking": "on",
		"font_family": "JetBrains Mono NL",
		"font_size": 12.0
	},
	"file_types": {
		"css": ["*.css"]
	},
	"linked_edits": true,
	"wrap_guides": [120],
	"preferred_line_length": 120,
	"soft_wrap": "preferred_line_length",
	"base_keymap": "VSCode",
	"agent": {
		"button": false,
		"enabled": false
	},
	"chat_panel": {
		"button": "never"
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"icon_theme": "JetBrains New UI Icons (Dark)",
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "JetBrains New Dark"
	},
	"hard_tabs": true,
	"tab_size": 4,
	"format_on_save": "on",
	"autosave": "off",
	"ui_font_size": 14,
	"buffer_font_size": 13.0,
	"ui_font_family": "JetBrains Mono NL",
	"buffer_font_family": "JetBrains Mono NL",
	"scrollbar": {
		"show": "always"
	},
	"tabs": {
		"close_position": "right",
		"file_icons": false,
		"git_status": true
	},
	"languages": {
		"JavaScript": {
			"code_actions_on_format": {
				"source.fixAll.eslint": true
			}
		},
		"TypeScript": {
			"code_actions_on_format": {
				"source.fixAll.eslint": true
			}
		}
	},
	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings",
		"**/.idea"
	]
}
