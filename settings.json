{
	"icon_theme": "Material Icon Theme",
	"restore_on_startup": "none",
	"theme": "JetBrains Dark Purple",
	"chat_panel": {
		"button": "never"
	},
	"features": {
		"edit_prediction_provider": "none",
		"copilot": false
	},
	"show_completions_on_input": true,
	"vim_mode": false,
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"hard_tabs": true,
	"tab_size": 4,
	"format_on_save": "on",
	"autosave": "off",
	"ui_font_size": 13,
	"buffer_font_size": 13,
	"ui_font_family": "JetBrains Mono",
	"buffer_font_family": "JetBrains Mono",
	"scrollbar": {
		"show": "always"
	},
	"tabs": {
		"close_position": "right",
		"file_icons": true,
		"git_status": true,
		"show_diagnostics": "all",
		"show_close_button": "hover"
	},
	"languages": {
		"JavaScript": {
			"code_actions_on_format": {
				"source.fixAll.eslint": true
			}
		},
		"TypeScript": {
			"code_actions_on_format": {
				"source.fixAll.eslint": true
			}
		}
	},
	"terminal": {
		"blinking": "on",
		"font_family": "JetBrains Mono NL",
		"font_size": 12,
		"cursor_shape": "bar"
	},
	"preferred_line_length": 120,
	"soft_wrap": "preferred_line_length",
	"assistant": {
		"enabled": false,
		"button": false,
		"version": "2"
	},
	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings",
		"**/.husky",
		"**/.idea",
		"**/.github"
	]
}
